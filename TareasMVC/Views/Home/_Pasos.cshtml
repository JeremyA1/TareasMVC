

<div class="section-heading">
    <h6 class="mb-0"><i class="bi bi-check-square me-2" aria-hidden="true"></i>Pasos de la tarea</h6>
    <button type="button" class="btn btn-secondary btn-sm" onclick="manejarClickAgregarPaso()" aria-label="Agregar paso">
        <i class="bi bi-plus" aria-hidden="true"></i>
    </button>
</div>

<div id="reordenable-pasos" data-bind="foreach: pasos">
    <div class="task-step mt-2">
        <div class="d-flex align-items-start gap-3">
            <div>
                <input 
                    type="checkbox" 
                    class="form-check-input" 
                    name="chbPaso" aria-label="Paso realizado"
                    data-bind="checked: realizado,
                    click: manejarClickCheckboxPaso,
                    attr:{'data-id': id}"
                />
            </div>

            <div class="task-step-content">
                <span style="cursor: pointer"
                    data-bind="text: descripcion, hidden: modoEdicion,
                    click: manejarClickDescripcionPaso,
                    css: {'text-decoration-line-through' : realizado}">
                </span>
                <textarea 
                    name="txtPasoDescripcion" 
                    class="form-control"
                    placeholder="Agregue una descripcion" aria-label="Descripción del paso"
                    data-bind="{value: descripcion, visible: modoEdicion }">
                </textarea>

                <div class="form-actions mt-2" data-bind="{visible: modoEdicion}">
                    <button 
                        class="btn btn-primary" 
                        data-bind="{click: manejarClickSalvarPaso}">
                            Salvar
                    </button>
                    <button 
                        class="btn btn-secondary" 
                        data-bind="{click: manejarClickCancelarPaso}">
                            Cancelar
                    </button>
                    <button class="btn btn-danger"
                            data-bind="
                            {hidden: esNuevo, 
                            click: manejarClickBorrarPaso}">
                            Borrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
